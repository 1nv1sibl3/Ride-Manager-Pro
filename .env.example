# ── Database (required) ─────────────────────────────────────────────
# Works with any Postgres. Two common options:
#
# Supabase: Project Settings → Database → Connection string →
#   "Connection pooling" → Session mode (port 5432 on the pooler host).
#   The session pooler works for both the schema sync and the app runtime.
#   Example:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Local Postgres:
#   postgresql://postgres:postgres@localhost:5432/probikes
#
# (lib/db.ts adds sslmode / pgbouncer / pool params automatically if missing.
#  If you use the transaction pooler — port 6543 — instead, that works too for
#  the app runtime; it is just not usable for schema pushes.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── First owner account (created by `npm run db:seed`) ──────────────
OWNER_USERNAME="owner"
OWNER_NAME="Shop Owner"
# Min 8 chars. Leave empty → a strong random password is generated and printed once.
OWNER_PASSWORD=""

# ── Email via Resend (optional — in-app notifications work without it) ──
# Create a key at https://resend.com. Empty → email silently disabled.
RESEND_API_KEY=""
EMAIL_FROM="ProBikes <onboarding@resend.dev>"

# ── Reminder cron endpoint (optional) ───────────────────────────────
# Protects GET /api/cron/reminders (Authorization: Bearer <secret>).
CRON_SECRET=""

# ── Misc (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # canonical URL for OG metadata

